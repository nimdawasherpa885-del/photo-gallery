# Supabase project URL — found in: Project Settings → API → Project URL
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon/public key — found in: Project Settings → API → Project API keys → anon public
# This key is safe to expose in frontend code. Never use the service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
